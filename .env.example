# URL canônica do site, usada em metadados, Open Graph, JSON-LD,
# robots.txt e sitemap.xml. Em produção, aponte para o domínio real.
NEXT_PUBLIC_SITE_URL=https://talkwise-english.vercel.app

# Endpoint opcional para o formulário de captura (Formspree, por exemplo).
# Sem esta variável o formulário apenas confirma visualmente, sem back-end.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/SEU_ID
