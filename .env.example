# URL canônica do site (usada em metadados, Open Graph e JSON-LD).
# Em produção, aponte para o domínio real do projeto.
NEXT_PUBLIC_SITE_URL=https://talkwise-english.vercel.app

# Endpoint opcional para o formulário de captura (ex.: Formspree).
# Sem esta variável o formulário apenas simula o envio, sem back-end.
